# ─── Email Configuration ───────────────────────────────────────────────────────

# SendGrid (Active — recommended for production)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your_sendgrid_api_key_here

# SMTP (alternative — uncomment and set EMAIL_PROVIDER=smtp to use)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password

# High-risk approval & alert recipients (comma-separated)
DQ_ALERT_RECIPIENTS=teja.jan220@gmail.com

# ─── Application Settings ──────────────────────────────────────────────────────
APP_NAME=AI-Agent Orchestrated Data Quality Observability & Intelligent Remediation
APP_ENV=development
LOG_LEVEL=INFO

# ─── Database ─────────────────────────────────────────────────────────────────
DB_PATH=src/db/dq_metadata.db

# ─── Auto-Fix Thresholds ──────────────────────────────────────────────────────
# Minimum successful resolutions before auto-fix is suggested
AUTO_FIX_MIN_RESOLUTIONS=3
# Auto-fix confidence threshold (0.0 - 1.0)
AUTO_FIX_CONFIDENCE_THRESHOLD=0.95

# ─── Plug & Play Data Connections ─────────────────────────────────────────────
# DEFAULT_CONN_TYPE: rdbms | snowflake | file | api
DEFAULT_CONN_TYPE=

# RDBMS (PostgreSQL, MySQL, SQLite, etc.)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASS=
DB_ENGINE=postgresql
DB_TABLE=

# Snowflake
SF_ACCOUNT=
SF_WH=
SF_DB=
SF_SCHEMA=PUBLIC
SF_TABLE=
SF_USER=
SF_PASS=

# Flat File
FILE_PATH=
FILE_FORMAT=CSV
FILE_SHEET=

# REST API
API_URL=
API_TOKEN=
API_HKEY=Authorization
API_JPATH=
API_METHOD=GET
